# Database Credentials
DB_USER=jobmatcher
DB_PASSWORD=secretpassword
DB_NAME=jobmatcher_db
# Host de la base de datos usado por n8n. Dentro de Docker es el nombre del servicio: postgres
DB_HOST=postgres

# pgAdmin (opcional)
PGADMIN_EMAIL=admin@jobmatcher.com
PGADMIN_PASSWORD=admin123

# Backend Security
# Genera un valor seguro, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=supersecretkey_for_jwt_override_in_production

# Entorno de ejecución: development | production
# En "production" el backend NO arrancará si JWT_SECRET conserva el valor inseguro por defecto.
ENVIRONMENT=development

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5678

# Google Gemini (extracción de CV) — nivel gratuito: https://aistudio.google.com/app/apikey
# Las claves de AI Studio pueden empezar por "AQ." (formato nuevo) o "AIza" (formato clásico); ambas son válidas.
GEMINI_API_KEY=
# Modelo a usar (opcional). Por defecto: gemini-3.5-flash-lite (gratis, ideal para extracción de datos)
GEMINI_MODEL=gemini-3.5-flash-lite
